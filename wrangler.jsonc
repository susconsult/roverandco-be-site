{
  "name": "roverandco-be-site",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/betaald"]
  },
  // Secrets staan in het Cloudflare-dashboard (niet hier): APPS_SCRIPT_URL, VIVA_CLIENT_ID,
  // VIVA_CLIENT_SECRET, VIVA_SOURCE_CODE, VIVA_WEBHOOK_KEY. Optioneel VIVA_OMGEVING = "demo".
  "keep_vars": true
}
