{
  "name": "roverandco-be-site",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  // APPS_SCRIPT_URL staat als Secret in het Cloudflare-dashboard (niet hier)
  "keep_vars": true
}
