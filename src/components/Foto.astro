---
// Eigen foto uit /assets/img: klein (-s, 800px) en groot (1600px).
interface Props { naam: string; alt?: string; klasse?: string; sizes?: string; prio?: boolean; pos?: string }
const { naam, alt = "", klasse, sizes = "100vw", prio = false, pos } = Astro.props;
---
<img class={klasse} src={`/assets/img/${naam}-s.webp`} srcset={`/assets/img/${naam}-s.webp 800w, /assets/img/${naam}.webp 1600w`} sizes={sizes} alt={alt} style={pos ? `object-position:${pos}` : undefined} fetchpriority={prio ? "high" : undefined} loading={prio ? undefined : "lazy"} />
